# ===========================================
# ARTEFACTOS GENERADOS POR EL PIPELINE
# (Regenerables corriendo el scraping/ETL/training; no se versionan
# porque crecen en cada corrida y hacen crecer el repo sin necesidad.
# scraping/atp_torneos_2026_final.csv es la ÚNICA excepción real: es la
# lista curada de torneos/URLs que alimenta al scraper, no un output.)
# ===========================================

# Modelos y trackers entrenados (models/predict_xgboost.py y matriz_confusion.png sí se versionan)
models/*.pkl
scraping/perfiles_jugadores.pkl

# Base de datos SQLite (se recrea con api/cargar_datos_db.py)
*.db

# CSVs intermedios/generados de scraping
scraping/atp_matches*.csv
scraping/ranking_2026.csv
scraping/ranking_actual_2026.csv
scraping/estadisticas_jugadores_avanzadas.csv

# Dataset final procesado (se regenera con fusionar_historico_final.py)
data/processed/*.csv

# NOTA: data/external/historial_tenis_COMPLETO.csv SÍ se versiona a propósito.
# No lo genera ningún script — es el dataset base externo (Jeff Sackmann), y
# sin él el pipeline entero no tiene desde dónde arrancar (CI incluido).

# Outputs de comparación de modelos
importancia_real.csv
resultados_comparacion.csv

# ===========================================
# STREAMLIT
# ===========================================
.streamlit/secrets.toml

